{
  "name": "ydm-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "release": "node scripts/release.mjs",
    "check": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "e2e:firefox": "npm run build:firefox && node e2e/firefox.mjs && node e2e/firefox-resume.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "5.3.0"
  }
}
