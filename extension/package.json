{
  "name": "ydm-extension",
  "private": true,
  "version": "1.0.1",
  "description": "YDM: faster, safer downloads inside the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "release": "node scripts/release.mjs",
    "check": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:firefox": "npm run build:firefox && node e2e/firefox.mjs && node e2e/firefox-resume.mjs",
    "screenshots": "node scripts/screenshots.mjs && node scripts/screenshots.mjs --lang it",
    "build:e2e": "node -e \"process.env.YDM_REPO=process.env.YDM_REPO||'ydm-test/ydm';require('child_process').execSync('npx wxt build',{stdio:'inherit',env:process.env})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "5.3.0"
  },
  "ydmRepo": "mrdragon1-code/ydm",
  "homepage": "https://github.com/mrdragon1-code/ydm",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrdragon1-code/ydm.git"
  },
  "bugs": {
    "url": "https://github.com/mrdragon1-code/ydm/issues"
  }
}
